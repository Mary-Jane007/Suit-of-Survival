# Copy this file to .env.local. Never commit .env.local or put real keys in git.
# Leave a line blank until you have that value. Do not invent keys.

# Project URL.
# Hosted: Project Settings → API → Project URL.
# Local: the API URL printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=

# Browser key. This is public. It is not the secret / service_role key.
# New projects: publishable key. Older projects: anon key. Set one of these.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Guest join writes a participant with no account, so the
# server needs a key that bypasses row level security.
# New projects: secret key. Older projects: service_role key. Set one.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
